# Copy to .env and fill in locally. Do NOT commit .env.
#
# ANTHROPIC_API_KEY  — required. Used by the Haiku committee judge AND by the
#                      Sonnet 4.6 NLI judge (factual grounding).
#                      Get one at https://console.anthropic.com/
#
# OPENROUTER_API_KEY — required when --committee is "default" or "conservative".
#                      Used by DeepSeek R1, Qwen 2.5 7B, and Mistral Nemo
#                      (the non-Anthropic judges). Get one at https://openrouter.ai/
#
# OPENAI_API_KEY     — optional. Not used by the current pipeline; kept for
#                      possible future OpenAI judge support.

ANTHROPIC_API_KEY=YOUR_KEY_HERE
OPENROUTER_API_KEY=YOUR_KEY_HERE
OPENAI_API_KEY=
